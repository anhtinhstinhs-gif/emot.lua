local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- KIỂM TRA REMOTE FUNCTION CÓ TỒN TẠI KHÔNG
local MenuToys = ReplicatedStorage:FindFirstChild("MenuToys")
if not MenuToys then
    warn("❌ Không tìm thấy 'MenuToys' trong ReplicatedStorage!")
    return
end

local SpawnToyRF = MenuToys:FindFirstChild("SpawnToyRemoteFunction")
if not SpawnToyRF then
    warn("❌ Không tìm thấy 'SpawnToyRemoteFunction' trong MenuToys!")
    return
end

-- CẤU HÌNH
local ACTION_NAME = "TaoNemAction"
local TOY_NAME = "VatTheNem"  -- ⚠️ CẦN ĐỔI TÊN CHO ĐÚNG VỚI GAME
local isToggled = false
local currentSpawnedToy = nil
local button = nil

-- HÀM KIỂM TRA VẬT THỂ
local function checkToyStatus()
    if not currentSpawnedToy or not currentSpawnedToy:IsDescendantOf(Workspace) then
        isToggled = false
        currentSpawnedToy = nil
        
        -- Đổi màu nút về đỏ nếu tồn tại
        if button then
            button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            local label = button:FindFirstChild("TextLabel")
            if label then label.Text = "Tạo ném" end
        end
        return true
    end
    return false
end

-- HÀM XỬ LÝ KHI BẤM NÚT
local function onButtonPress(actionName, inputState, inputObject)
    if inputState ~= Enum.UserInputState.Begin then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        warn("⚠️ Nhân vật chưa sẵn sàng!")
        return
    end
    
    -- Kiểm tra vật thể cũ nếu đang bật
    if isToggled then
        checkToyStatus()
    end
    
    if not isToggled then
        -- BẬT CHẾ ĐỘ: Tạo vật thể
        local cameraCFrame = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame or CFrame.new()
        local rotatePart = Workspace:FindFirstChild("RotateOrientPart")
        
        if not rotatePart then
            warn("⚠️ Không tìm thấy 'RotateOrientPart' trong Workspace!")
            return
        end
        
        -- GỌI REMOTE FUNCTION
        local success = SpawnToyRF:InvokeServer(TOY_NAME, cameraCFrame, rotatePart.Orientation)
        
        if success == "SpawnedToy" then
            isToggled = true
            
            -- TÌM VẬT THỂ VỪA TẠO
            task.spawn(function()
                task.wait(0.2)
                for _, child in pairs(Workspace:GetChildren()) do
                    if child.Name == TOY_NAME then
                        local distance = (child:GetPivot().Position - character.HumanoidRootPart.Position).Magnitude
                        if distance < 15 then
                            currentSpawnedToy = child
                            currentSpawnedToy.Destroying:Connect(function()
                                task.wait(0.1)
                                checkToyStatus()
                            end)
                            break
                        end
                    end
                end
            end)
            
            -- ĐỔI MÀU NÚT
            if button then
                button.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
                local label = button:FindFirstChild("TextLabel")
                if label then label.Text = "Đã tạo" end
            end
        else
            warn("❌ Remote Function trả về lỗi: ", success)
        end
    else
        -- TẮT CHẾ ĐỘ: Xóa vật thể
        if currentSpawnedToy then
            currentSpawnedToy:Destroy()
            currentSpawnedToy = nil
        end
        isToggled = false
        
        if button then
            button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            local label = button:FindFirstChild("TextLabel")
            if label then label.Text = "Tạo ném" end
        end
    end
end

-- TẠO NÚT TRÊN MÀN HÌNH
ContextActionService:BindAction(ACTION_NAME, onButtonPress, true, Enum.KeyCode.F)

-- ĐỢI NÚT ĐƯỢC TẠO
task.wait(0.5)
button = ContextActionService:GetButton(ACTION_NAME)

if not button then
    warn("❌ Không thể tạo nút trên màn hình!")
    return
end

-- TÙY CHỈNH NÚT
button.Size = UDim2.new(0, 90, 0, 90)
button.Position = UDim2.new(0.5, -45, 0.5, -45)
button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)

-- TẠO NHÃN CHO NÚT
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 1, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "Tạo ném"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.Font = Enum.Font.SourceSansBold
titleLabel.TextSize = 16
titleLabel.Parent = button

print("✅ Script đã tải thành công! Nút 'Tạo ném' sẽ xuất hiện trên màn hình.")
