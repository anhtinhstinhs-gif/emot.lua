-- XÓA SẠCH CODE CŨ VÀ DÁN TOÀN BỘ CODE DƯỚI ĐÂY

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

-- 1. Khai báo Remote Event từ đoạn code 1 của bạn
local ClickActionEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ClickAction")

-- 2. Khai báo MainUI Controller từ đoạn code 2 của bạn
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local MainUIController = PlayerGui:WaitForChild("MainUI"):WaitForChild("MainUIController")

-- 3. Khởi chạy Modules Runtime từ đoạn code 3 của bạn để đồng bộ hệ thống game
local ModulesFolder = ReplicatedStorage:WaitForChild("Modules")
local MainUIRuntime = require(ModulesFolder:WaitForChild("MainUIRuntime"))
task.spawn(function()
    pcall(function()
        MainUIRuntime.init()
    end)
end)

-- Cấu hình trạng thái Auto Click
local ACTION_NAME = "AutoClickAction"
local isAutoActive = false

-- Hàm chạy vòng lặp kích hoạt liên tục (Auto Click)
local function startAutoLoop()
    task.spawn(function()
        while isAutoActive do
            -- Gọi liên tục ClickAction Event không ngừng nghỉ
            pcall(function()
                ClickActionEvent:FireServer()
            end)
            task.wait(0.1) -- Khoảng thời gian giãn cách giữa mỗi lần click (0.1 giây), có thể chỉnh nhỏ hơn nếu muốn nhanh hơn
        end
    end)
end

-- Hàm xử lý khi bấm nút bật/tắt
local function onButtonPress(actionName, inputState, inputObject)
    if inputState == Enum.UserInputState.Begin then
        if not isAutoActive then
            -- TRẠNG THÁI 1: BẬT - Kích hoạt Auto liên tục
            isAutoActive = true
            startAutoLoop()
            
            -- Đổi màu nút sang màu xám/tối để báo hiệu đang chạy Auto
            local button = ContextActionService:GetButton(ACTION_NAME)
            if button then
                button.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
            end
        else
            -- TRẠNG THÁI QUAY LẠI 1: TẮT - Ngừng chạy Auto
            isAutoActive = false
            
            -- Đặt lại nút về màu đỏ ban đầu
            local button = ContextActionService:GetButton(ACTION_NAME)
            if button then
                button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            end
        end
    end
end

-- Khởi tạo nút bấm màu đỏ trên thiết bị di động
ContextActionService:UnbindAction(ACTION_NAME) -- Xóa bỏ cấu hình cũ tránh trùng lặp
ContextActionService:BindAction(ACTION_NAME, onButtonPress, true, Enum.KeyCode.F)

local mobileButton = ContextActionService:GetButton(ACTION_NAME)
if mobileButton then
    mobileButton.Size = UDim2.new(0, 90, 0, 90)
    mobileButton.Position = UDim2.new(0.15, 0, 0.5, -45) -- Vị trí thuận tiện trên màn hình điện thoại
    mobileButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Nút màu đỏ đặc trưng
    
    -- Tạo nhãn chữ hiển thị "Tạo ném" hoặc "Auto Click"
    local titleLabel = mobileButton:FindFirstChild("TitleLabel") or Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Size = UDim2.new(1, 0, 1, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = "Auto Click"
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.Font = Enum.Font.SourceSansBold
    titleLabel.TextSize = 16
    titleLabel.Parent = mobileButton
end
