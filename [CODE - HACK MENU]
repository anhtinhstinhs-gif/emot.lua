local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local ACTION_NAME = "TaoNemAction"
local isToggled = false
local spawnedPart = nil

-- Hàm xử lý khi bấm nút
local function onButtonPress(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin then
		local character = LocalPlayer.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return end
		
		if not isToggled then
			-- TRẠNG THÁI 1: BẬT (Xuất hiện vật thể dưới chân)
			isToggled = true
			
			-- Tạo vật thể (Ví dụ: một khối Part màu đỏ làm vật ném)
			spawnedPart = Instance.new("Part")
			spawnedPart.Name = "VatTheNem"
			spawnedPart.Size = Vector3.new(2, 2, 2)
			spawnedPart.Color = Color3.fromRGB(255, 0, 0)
			spawnedPart.Material = Enum.Material.Neon
			
			-- Đặt vị trí ngay dưới chân nhân vật (HRP)
			local hrp = character.HumanoidRootPart
			spawnedPart.CFrame = hrp.CFrame * CFrame.new(0, -2.5, 0)
			spawnedPart.Parent = workspace
			
			-- Đổi màu nút trên điện thoại sang màu xám để báo hiệu đang hoạt động
			local button = ContextActionService:GetButton(ACTION_NAME)
			if button then
				button.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
			end
			
			-- Theo dõi nếu vật thể bị mất/xóa thì tự động quay lại Trạng thái ban đầu
			spawnedPart.Destroying:Connect(function()
				isToggled = false
				local btn = ContextActionService:GetButton(ACTION_NAME)
				if btn then
					btn.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Quay lại màu đỏ
				end
			end)
		else
			-- TRẠNG THÁI QUAY LẠI BAN ĐẦU: TẮT (Xóa vật thể cũ để chuẩn bị cho lần bấm tiếp theo)
			if spawnedPart then
				spawnedPart:Destroy()
				spawnedPart = nil
			end
			isToggled = false
			
			-- Đặt lại màu đỏ cho nút bấm
			local button = ContextActionService:GetButton(ACTION_NAME)
			if button then
				button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
			end
		end
	end
end

-- Khởi tạo nút bấm chuyên dụng cho thiết bị di động (Mobile Button)
ContextActionService:BindAction(ACTION_NAME, onButtonPress, true, Enum.KeyCode.F)

-- Cấu hình giao diện nút bấm điện thoại
local mobileButton = ContextActionService:GetButton(ACTION_NAME)
if mobileButton then
	mobileButton.Size = UDim2.new(0, 80, 0, 80)
	mobileButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Nút màu đỏ
	
	-- Thiết lập tên hiển thị của nút là "Tạo Ném"
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, 0, 1, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "Tạo ném"
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.Font = Enum.Font.SourceSansBold
	titleLabel.TextSize = 16
	titleLabel.Parent = mobileButton
end
