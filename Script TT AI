loadstring([[
    local Player = game:GetService("Players").LocalPlayer
    local UserInputService = game:GetService("UserInputService")

    -- Tạo ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "FlyMenu"
    ScreenGui.Parent = Player:WaitForChild("PlayerGui")

    -- Tạo Frame background
    local Frame = Instance.new("Frame")
    Frame.Name = "MenuFrame"
    Frame.Size = UDim2.new(0, 160, 0, 190)
    Frame.Position = UDim2.new(0, 10, 0, 10)
    Frame.BackgroundColor3 = Color3.new(0, 0, 0) -- Màu đen
    Frame.BackgroundTransparency = 0.2
    Frame.BorderSizePixel = 2
    Frame.BorderColor3 = Color3.new(1, 0, 0) -- Màu đỏ
    Frame.Parent = ScreenGui

    -- Tạo nút "UP"
    local UpButton = Instance.new("TextButton")
    UpButton.Name = "UpButton"
    UpButton.Size = UDim2.new(0, 50, 0, 50)
    UpButton.Position = UDim2.new(0, 5, 0, 5)
    UpButton.BackgroundColor3 = Color3.new(0, 1, 0) -- Màu xanh lá
    UpButton.Font = Enum.Font.SourceSansBold
    UpButton.Text = "UP"
    UpButton.TextColor3 = Color3.new(1, 1, 1)
    UpButton.Parent = Frame

    -- Tạo nút "DOWN"
    local DownButton = Instance.new("TextButton")
    DownButton.Name = "DownButton"
    DownButton.Size = UDim2.new(0, 50, 0, 50)
    DownButton.Position = UDim2.new(0, 65, 0, 5)
    DownButton.BackgroundColor3 = Color3.new(0, 1, 0) -- Màu xanh lá
    DownButton.Font = Enum.Font.SourceSansBold
    DownButton.Text = "DOWN"
    DownButton.TextColor3 = Color3.new(1, 1, 1)
    DownButton.Parent = Frame

    -- Tạo nút "FLY"
    local FlyButton = Instance.new("TextButton")
    FlyButton.Name = "FlyButton"
    FlyButton.Size = UDim2.new(0, 50, 0, 50)
    FlyButton.Position = UDim2.new(0, 125, 0, 5)
    FlyButton.BackgroundColor3 = Color3.new(1, 1, 0) -- Màu vàng
    FlyButton.Font = Enum.Font.SourceSansBold
    FlyButton.Text = "fly"
    FlyButton.TextColor3 = Color3.new(0, 0, 0)
    FlyButton.Parent = Frame

    -- Tạo TextLabel hiển thị "1"
    local NumberLabel = Instance.new("TextLabel")
    NumberLabel.Name = "NumberLabel"
    NumberLabel.Size = UDim2.new(0, 50, 0, 50)
    NumberLabel.Position = UDim2.new(0, 5, 0, 60)
    NumberLabel.BackgroundColor3 = Color3.new(1, 1, 1) -- Màu trắng
    NumberLabel.BackgroundTransparency = 1
    NumberLabel.Font = Enum.Font.SourceSansBold
    NumberLabel.Text = "1"
    NumberLabel.TextColor3 = Color3.new(0, 0, 255) -- Màu xanh lam
    NumberLabel.TextSize = 24
    NumberLabel.Parent = Frame

    -- Hàm cập nhật số liệu
    local function updateNumber()
        NumberLabel.Text = "1" -- Thay đổi logic cập nhật ở đây
    end

    -- Sự kiện nhấn nút "UP"
    UpButton.MouseButton1Click:Connect(function()
        -- Thay đổi tốc độ bay hoặc thực hiện hành động "UP"
        updateNumber()
    end)

    -- Sự kiện nhấn nút "DOWN"
    DownButton.MouseButton1Click:Connect(function()
        -- Thay đổi tốc độ bay hoặc thực hiện hành động "DOWN"
        updateNumber()
    end)

    -- Sự kiện nhấn nút "FLY"
    FlyButton.MouseButton1Click:Connect(function()
        -- Bật/tắt chế độ bay hoặc thực hiện hành động "fly"
        updateNumber()
    end)
]])()
