-- SpeedHack Menu x2 Tốc Độ (Bọc pcall an toàn)
-- Chạy trong môi trường Roblox Lua (Client-side)

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

local isSpeedActive = false
local baseSpeed = 16
local speedMultiplier = 2
local targetSpeed = baseSpeed * speedMultiplier

-- Tạo GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SpeedHackMenu"
screenGui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 150, 0, 50)
frame.Position = UDim2.new(0.5, -75, 0.8, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.BackgroundTransparency = 0.3
frame.Active = true
frame.Draggable = true
frame.Parent = screenGui

local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -10, 1, -10)
button.Position = UDim2.new(0, 5, 0, 5)
button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
button.Text = "TẮT (x1)"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Font = Enum.Font.SourceSansBold
button.TextSize = 18
button.Parent = frame

-- Hàm cập nhật tốc độ với pcall
local function updateSpeed()
    pcall(function()
        if humanoid and humanoid.Parent then
            humanoid.WalkSpeed = isSpeedActive and targetSpeed or baseSpeed
        end
    end)
end

-- Xử lý khi nhân vật thay đổi
player.CharacterAdded:Connect(function(newChar)
    pcall(function()
        character = newChar
        humanoid = character:WaitForChild("Humanoid")
        isSpeedActive = false
        button.Text = "TẮT (x1)"
        button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        updateSpeed()
    end)
end)

-- Sự kiện nhấn nút
button.MouseButton1Click:Connect(function()
    pcall(function()
        isSpeedActive = not isSpeedActive
        if isSpeedActive then
            button.Text = "BẬT (x2)"
            button.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        else
            button.Text = "TẮT (x1)"
            button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        end
        updateSpeed()
    end)
end)

-- Vòng lặp giám sát với pcall
game:GetService("RunService").Heartbeat:Connect(function()
    pcall(function()
        if isSpeedActive and humanoid and humanoid.Parent and humanoid.WalkSpeed ~= targetSpeed then
            humanoid.WalkSpeed = targetSpeed
        end
    end)
end)

-- Khởi tạo
updateSpeed()
