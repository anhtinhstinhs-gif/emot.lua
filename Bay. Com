-- Joystick logic
local dragging = false
local dragStart = nil
local maxDist = (isPhone and isWideScreen) and 60 or (isPhone and 70 or 50)

joystickFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
    end
end)

joystickFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        joystickKnob.Position = UDim2.new(0.5, -knobSize/2, 0.5, -knobSize/2)
        moveDirection = Vector3.new(0, 0, 0)
    end
end)

userInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        local dist = math.min(delta.Magnitude, maxDist)
        local angle = math.atan2(delta.Y, delta.X)
        
        local x = math.cos(angle) * dist
        local y = math.sin(angle) * dist
        
        joystickKnob.Position = UDim2.new(0.5, -knobSize/2 + x, 0.5, -knobSize/2 + y)
        
        if flying and bodyVelocity then
            local forward = rootPart.CFrame.LookVector
            local right = rootPart.CFrame.RightVector
            
            local moveX = x / maxDist
            local moveY = -y / maxDist
            
            moveDirection = (right * moveX + forward * moveY)
            if moveDirection.Magnitude > 0 then
                moveDirection = moveDirection.Unit * flySpeed
            end
        end
    end
end)

