-- Start flight function
local function startFlight()
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
    
    humanoid.PlatformStand = true
    flying = true
end

-- Stop flight function
local function stopFlight()
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    humanoid.PlatformStand = false
    flying = false
end

-- Toggle expand/minimize
local function toggleMenu()
    isExpanded = not isExpanded
    minFrame.Visible = not isExpanded
    maxFrame.Visible = isExpanded
end

-- Close button click
closeBtn.MouseButton1Click:Connect(function()
    stopFlight()
    screenGui:Destroy()
end)

-- Expand button click
expandBtn.MouseButton1Click:Connect(function()
    toggleMenu()
end)

-- BAY button click
bayButton.MouseButton1Click:Connect(function()
    if flying then
        stopFlight()
        bayButton.Text = "🪶 BAY  ◄  01  ►"
    else
        startFlight()
        bayButton.Text = "🪶 BAY (ON)  ◄  01  ►"
    end
end)

