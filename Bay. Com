local moveButtons = {}
local buttonsConfig = {
    {name = "BtnUp", text = "▲", color = Color3.fromRGB(0, 200, 100), key = "W", row = 0},
    {name = "BtnDown", text = "▼", color = Color3.fromRGB(200, 0, 100), key = "S", row = 2},
    {name = "BtnLeft", text = "◄", color = Color3.fromRGB(255, 200, 0), key = "A", row = 1},
    {name = "BtnRight", text = "►", color = Color3.fromRGB(255, 100, 0), key = "D", row = 1},
    {name = "BtnJump", text = "⬆", color = Color3.fromRGB(200, 0, 200), key = "Space", row = 1}
}

-- Kích thước nút nhỏ hơn
local btnW = (isPhone and isWideScreen) and 55 or (isPhone and 60 or 50)
local btnH = btnW

for _, config in ipairs(buttonsConfig) do
    local btn = Instance.new("TextButton")
    btn.Name = config.name
    btn.Size = UDim2.new(0, btnW, 0, btnH)
    
    -- Vị trí dọc (5 nút - hình chữ thập + Space) - dịch sang phải hơn
    if config.row == 0 then
        btn.Position = UDim2.new(1, -(btnW + 5), 0.2, 0)
    elseif config.row == 1 then
        if config.key == "A" then
            btn.Position = UDim2.new(1, -(btnW * 2 + 15), 0.3, btnH + 5)
        elseif config.key == "D" then
            btn.Position = UDim2.new(1, -5, 0.3, btnH + 5)
        else -- Space
            btn.Position = UDim2.new(1, -(btnW + 5), 0.4, btnH * 2 + 10)
        end
    elseif config.row == 2 then
        btn.Position = UDim2.new(1, -(btnW + 5), 0.3, btnH * 2 + 10)
    end
    
    btn.BackgroundColor3 = config.color
    btn.BackgroundTransparency = 0.5
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = isPhone and 35 or 30
    btn.Font = Enum.Font.GothamBold
    btn.Text = config.text
    btn.BorderSizePixel = 2
    btn.BorderColor3 = Color3.fromRGB(255, 255, 255)
    btn.Visible = false
    btn.Parent = screenGui
    
    moveButtons[config.key] = btn
    
    -- Xử lý click
    local function onPressed()
        btn.BackgroundTransparency = 0.1
        if flying and bodyVelocity then
            if config.key == "W" then
                moveDirection = moveDirection + rootPart.CFrame.LookVector * flySpeed
            elseif config.key == "A" then
                moveDirection = moveDirection - rootPart.CFrame.RightVector * flySpeed
            elseif config.key == "S" then
                moveDirection = moveDirection - rootPart.CFrame.LookVector * flySpeed
            elseif config.key == "D" then
                moveDirection = moveDirection + rootPart.CFrame.RightVector * flySpeed
            elseif config.key == "Space" then
                moveDirection = moveDirection + Vector3.new(0, flySpeed, 0)
            end
        end
    end
    
    local function onReleased()
        btn.BackgroundTransparency = 0.5
        if flying and bodyVelocity then
            if config.key == "W" then
                moveDirection = moveDirection - rootPart.CFrame.LookVector * flySpeed
            elseif config.key == "A" then
                moveDirection = moveDirection + rootPart.CFrame.RightVector * flySpeed
            elseif config.key == "S" then
                moveDirection = moveDirection + rootPart.CFrame.LookVector * flySpeed
            elseif config.key == "D" then
                moveDirection = moveDirection - rootPart.CFrame.RightVector * flySpeed
            elseif config.key == "Space" then
                moveDirection = moveDirection - Vector3.new(0, flySpeed, 0)
            end
        end
    end
    
    btn.MouseButton1Down:Connect(onPressed)
    btn.MouseButton1Up:Connect(onReleased)
end

-- Flight variables
local flying = false
local flySpeed = 50
local currentColor = 3
local bodyVelocity = nil
local bodyGyro = nil
local moveDirection = Vector3.new(0, 0, 0)
local flyCounter = 0

local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Start flight function
local function startFlight()
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
    
    humanoid.PlatformStand = true
    flying = true
    flyCounter = flyCounter + 1
    counterLabel.Text = tostring(flyCounter)
    
    -- Hiện nút di chuyển và counter khi bay
    if isPhone then
        for _, btn in pairs(moveButtons) do
            btn.Visible = true
        end
    end
    counterLabel.Visible = true
end

local function stopFlight()
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    humanoid.PlatformStand = false
    flying = false
    
    -- Ẩn nút di chuyển và counter khi tắt bay
    if isPhone then
        for _, btn in pairs(moveButtons) do
            btn.Visible = false
        end
    end
    counterLabel.Visible = false
end

-- Collapse/Expand
local function collapseMenu()
    mainFrame.Visible = false
    miniFrame.Visible = true
end

local function expandMenu()
    mainFrame.Visible = true
    miniFrame.Visible = false
end

collapseButton.MouseButton1Click:Connect(collapseMenu)
miniExpandButton.MouseButton1Click:Connect(expandMenu)

-- BAY button
bayButton.MouseButton1Click:Connect(function()
    if flying then
        stopFlight()
        bayButton.Text = "🪶 BAY"
    else
        startFlight()
        bayButton.Text = "🪶 BAY (ON)"
    end
end)

-- Speed controls
speedLeft.MouseButton1Click:Connect(function()
    flySpeed = math.max(5, flySpeed - 5)
    speedLabel.Text = "⏱️ TỐC ĐỘ  " .. flySpeed
end)

speedRight.MouseButton1Click:Connect(function()
    flySpeed = flySpeed + 5
    speedLabel.Text = "⏱️ TỐC ĐỘ  " .. flySpeed
end)

-- Color controls
colorLeft.MouseButton1Click:Connect(function()
    currentColor = math.max(1, currentColor - 1)
    colorLabel.Text = "🎨 PHONG MÀU  " .. string.format("%02d", currentColor)
end)

colorRight.MouseButton1Click:Connect(function()
    currentColor = currentColor + 1
    colorLabel.Text = "🎨 PHONG MÀU  " .. string.format("%02d", currentColor)
end)

-- EXIT
exitButton.MouseButton1Click:Connect(function()
    stopFlight()
    screenGui:Destroy()
end)

-- ===== DRAGGABLE MENU =====
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and canDrag and mainFrame.Visible then
        isDragging = true
        dragOffset = input.Position - mainFrame.AbsolutePosition
    end
end)

userInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
    end
end)

userInputService.InputChanged:Connect(function(input)
    if isDragging and canDrag and mainFrame.Visible then
        local newPos = input.Position - dragOffset
        mainFrame.Position = UDim2.new(0, newPos.X, 0, newPos.Y)
    end
end)

-- Cập nhật di chuyển (PC + Mobile)
runService.Heartbeat:Connect(function(deltaTime)
    if not flying or not bodyVelocity then return end
    
    local finalMove = moveDirection
    
    -- PC Controls (bàn phím)
    if not isPhone then
        finalMove = Vector3.new(0, 0, 0)
        
        if userInputService:IsKeyDown(Enum.KeyCode.W) then
            finalMove = finalMove + rootPart.CFrame.LookVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.S) then
            finalMove = finalMove - rootPart.CFrame.LookVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.A) then
            finalMove = finalMove - rootPart.CFrame.RightVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.D) then
            finalMove = finalMove + rootPart.CFrame.RightVector
        end
        
        if finalMove.Magnitude > 0 then
            finalMove = finalMove.Unit * flySpeed
        end
        
        if userInputService:IsKeyDown(Enum.KeyCode.Q) then
            finalMove = finalMove + Vector3.new(0, flySpeed, 0)
        end
        if userInputService:IsKeyDown(Enum.KeyCode.E) then
            finalMove = finalMove - Vector3.new(0, flySpeed, 0)
        end
    end
    
    bodyVelocity.Velocity = finalMove
    bodyGyro.CFrame = rootPart.CFrame
end)

-- Cleanup
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    flying = false
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
    
    -- Ẩn nút di chuyển và counter
    if isPhone then
        for _, btn in pairs(moveButtons) do
            btn.Visible = false
        end
    end
    counterLabel.Visible = false
end)
