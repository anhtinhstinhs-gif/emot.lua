-- Cập nhật di chuyển
runService.Heartbeat:Connect(function(deltaTime)
    if not flying or not bodyVelocity then return end
    
    local finalMove = moveDirection
    
    -- Thêm lên/xuống nếu đang giữ nút
    if upPressed then
        finalMove = finalMove + Vector3.new(0, flySpeed, 0)
    end
    if downPressed then
        finalMove = finalMove - Vector3.new(0, flySpeed, 0)
    end
    
    -- PC controls
    if not isPhone then
        finalMove = Vector3.new(0, 0, 0)
        
        if userInputService:IsKeyDown(Enum.KeyCode.W) then
            finalMove = finalMove + rootPart.CFrame.LookVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.S) then
            finalMove = finalMove - rootPart.CFrame.LookVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.A) then
            finalMove = finalMove - rootPart.CFrame.RightVector
        end
        if userInputService:IsKeyDown(Enum.KeyCode.D) then
            finalMove = finalMove + rootPart.CFrame.RightVector
        end
        
        if finalMove.Magnitude > 0 then
            finalMove = finalMove.Unit * flySpeed
        end
        
        if userInputService:IsKeyDown(Enum.KeyCode.Q) then
            finalMove = finalMove + Vector3.new(0, flySpeed, 0)
        end
        if userInputService:IsKeyDown(Enum.KeyCode.E) then
            finalMove = finalMove - Vector3.new(0, flySpeed, 0)
        end
    end
    
    bodyVelocity.Velocity = finalMove
    bodyGyro.CFrame = rootPart.CFrame
end)

